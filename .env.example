# Postgres auf dem Hetzner-Server. Lokal per SSH-Tunnel erreichbar
# (die DB ist nur auf localhost gebunden, siehe Vault-Notiz hetzner-postgres-localhost).
#
# WICHTIG: Ein Dollarzeichen im Passwort muss als \$ geschrieben werden.
# Der Env-Loader von Next interpretiert sonst $VAR und schneidet den Wert still ab.
DATABASE_URL="postgres://startklar:PASSWORT@127.0.0.1:5432/startklar"

# Geheimnis fuer die signierte Admin-Session (jose). Auf dem Server eigens
# erzeugen, nicht den lokalen Wert uebernehmen:  openssl rand -base64 48
SESSION_SECRET="lokales-entwicklungsgeheimnis-bitte-ersetzen"

# Wird von seed:admin genutzt, um den ersten Admin anzulegen bzw. sein
# Passwort zu setzen. Danach kann die Zeile raus.
ADMIN_EMAIL="carstenbeuge@gmail.com"
ADMIN_PASSWORD="lokal-nur-zum-testen"

# Salt fuer den Tages-IP-Hash im Klick-Tracking (DSGVO: keine Klar-IP speichern).
IP_HASH_SALT="beliebiger-zufallswert"

# Oeffentliche Basis-URL, fuer absolute Links in Sitemap und Metadaten.
NEXT_PUBLIC_BASE_URL="http://localhost:3006"

# SMTP fuer die Newsletter-Bestaetigungsmail (Double-Opt-in). Ohne diese Werte
# wird die Adresse gespeichert, aber keine Mail verschickt (Log-Hinweis).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="startklar.tools <noreply@startklar.tools>"
